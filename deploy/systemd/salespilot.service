# SalesPilot Docker Compose systemd unit.
# CHANGE_ME: If the repo is deployed somewhere else, replace every
# /opt/salespilot-v2 path below with the real deploy directory.

[Unit]
Description=SalesPilot production Docker Compose stack
Documentation=file:/opt/salespilot-v2/docs/nginx-ssl-vps-deployment.md
Wants=network-online.target docker.service
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/salespilot-v2
TimeoutStartSec=0
TimeoutStopSec=120

ExecStartPre=/usr/bin/test -f /opt/salespilot-v2/.env.production
ExecStartPre=/usr/bin/docker compose --env-file /opt/salespilot-v2/.env.production -f /opt/salespilot-v2/docker-compose.prod.yml config --quiet
ExecStart=/usr/bin/docker compose --env-file /opt/salespilot-v2/.env.production -f /opt/salespilot-v2/docker-compose.prod.yml up -d --remove-orphans
ExecReload=/usr/bin/docker compose --env-file /opt/salespilot-v2/.env.production -f /opt/salespilot-v2/docker-compose.prod.yml up -d --build --remove-orphans
ExecStop=/usr/bin/docker compose --env-file /opt/salespilot-v2/.env.production -f /opt/salespilot-v2/docker-compose.prod.yml down --remove-orphans

[Install]
WantedBy=multi-user.target
