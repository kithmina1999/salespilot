# Copy to /etc/salespilot/deploy.env on the VPS and edit there.
# This is a shell-safe file used by deploy/scripts/deploy-production.sh.

APP_DIR=/opt/salespilot-v2
APP_ENV_FILE=/opt/salespilot-v2/.env.production
COMPOSE_FILE=/opt/salespilot-v2/docker-compose.prod.yml

# compose is the most predictable deploy path because it always builds.
# systemd uses salespilot.service and then falls back to compose build when needed.
DEPLOY_STRATEGY=compose
SYSTEMD_SERVICE=salespilot

# Take a DB backup before rebuilding/restarting services.
RUN_PRE_DEPLOY_BACKUP=true
BACKUP_SERVICE=salespilot-db-backup.service
BACKUP_ENV_FILE=/etc/salespilot/backup.env

# Run reviewed database migrations before starting/restarting the app services.
RUN_DATABASE_MIGRATIONS=true
MIGRATION_SERVICE=migrate

# Keep these aligned with docker-compose.prod.yml service names.
REQUIRED_SERVICES="postgres redis backend frontend admin landing loki alloy grafana"

# Local checks verify the app stack before Nginx/public DNS gets involved.
LOCAL_HEALTH_URLS="http://127.0.0.1:8080/health http://127.0.0.1:3000 http://127.0.0.1:3001 http://127.0.0.1:3002 http://127.0.0.1:3003/api/health"

# Set CHECK_PUBLIC_HEALTH=false before DNS/SSL/Nginx are ready.
CHECK_PUBLIC_HEALTH=true
PUBLIC_HEALTH_URLS="https://api.salespilot.lk/health https://app.salespilot.lk https://admin.salespilot.lk https://salespilot.lk"

CHECK_NGINX=true
HEALTH_TIMEOUT_SECONDS=240
HEALTH_INTERVAL_SECONDS=5
CURL_MAX_TIME_SECONDS=10
