# Copy to /etc/salespilot/backup.env on the VPS and edit there.
# Keep this file shell-safe: quote values that contain spaces.

APP_DIR=/opt/salespilot-v2
APP_ENV_FILE=/opt/salespilot-v2/.env.production
COMPOSE_FILE=/opt/salespilot-v2/docker-compose.prod.yml

# CHANGE_ME: mount a separate VPS disk or volume here before enabling backups.
BACKUP_DIR=/mnt/salespilot-backups/postgres
BACKUP_RETENTION_DAYS=14
BACKUP_PASSPHRASE_FILE=/etc/salespilot/backup-passphrase

# Offsite upload is optional but recommended. Any S3-compatible provider works:
# Cloudflare R2, AWS S3, Backblaze B2 S3, Supabase Storage S3, etc.
BACKUP_OFFSITE_ENABLED=false
BACKUP_S3_ENDPOINT_URL=https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=salespilot-backups
BACKUP_S3_PREFIX=postgres
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=CHANGE_ME
BACKUP_S3_SECRET_ACCESS_KEY=CHANGE_ME
