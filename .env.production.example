# Copy this file to .env.production on the VPS and replace every placeholder.
# Never commit .env.production. See docs/environment-variables.md for the full
# reference, including Compose-managed, local-only, deploy, and backup variables.

# Compose images and loopback ports. Keep ports aligned with Nginx.
IMAGE_TAG=latest
BACKEND_PORT=8080
FRONTEND_PORT=3000
ADMIN_PORT=3001
LANDING_PORT=3002

# Public origins. FRONTEND_URL is a comma-separated CORS allowlist; keep the
# tenant app first because PayHere redirects use its first origin.
SERVER_URL=https://api.salespilot.lk
FRONTEND_URL=https://app.salespilot.lk,https://admin.salespilot.lk

# Backend observability. APP_RELEASE falls back to SENTRY_RELEASE, then IMAGE_TAG.
APP_ENV=production
APP_RELEASE=
LOG_FORMAT=json
LOG_LEVEL=info

# Public landing metadata. NEXT_PUBLIC_* values are embedded at image build
# time, so changing them requires rebuilding the landing image.
NEXT_PUBLIC_SITE_URL=https://salespilot.lk
NEXT_PUBLIC_APP_URL=https://app.salespilot.lk
NEXT_PUBLIC_SUPPORT_EMAIL=support@salespilot.lk
NEXT_PUBLIC_SUPPORT_PHONE_NUMBER=+94771234567
NEXT_PUBLIC_COMPANY_NAME=SalesPilot
NEXT_PUBLIC_COMPANY_ADDRESS=Sri Lanka

# Tenant frontend error tracking. Keep disabled until both DSNs are filled.
# SENTRY_AUTH_TOKEN is needed only for source-map uploads during image builds.
SENTRY_ENABLED=false
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_AUTH_TOKEN=
SENTRY_ORG=salespilot-5b
SENTRY_FRONTEND_PROJECT=frontend-salespilot
SENTRY_FRONTEND_DSN=
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_FRONTEND_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Loki, Grafana Alloy, and Grafana. Grafana and Alloy bind to 127.0.0.1.
GRAFANA_PORT=3003
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_32_CHAR_PASSWORD
GRAFANA_ROOT_URL=http://localhost:3003
GRAFANA_IMAGE_TAG=13.0.0
LOKI_IMAGE_TAG=3.7.0
ALLOY_IMAGE_TAG=v1.17.0
ALLOY_PORT=12345

# Bundled PostgreSQL. Generate one password with `openssl rand -hex 32` and
# use the same value in POSTGRES_PASSWORD and DATABASE_URL.
POSTGRES_DB=salespilot
POSTGRES_USER=salespilot
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_64_CHAR_HEX
DATABASE_URL=postgresql://salespilot:REPLACE_WITH_RANDOM_64_CHAR_HEX@postgres:5432/salespilot?sslmode=disable

# Leave REDIS_URL empty for bundled Redis. Use redis:// or rediss:// for a
# managed Redis/Valkey service. Production Compose forces STATE_STORE=redis.
REDIS_URL=
REDIS_KEY_PREFIX=salespilot

# Core secrets. Generate JWT_SECRET with `openssl rand -hex 32` and
# MASTER_API_KEY with `openssl rand -hex 24`.
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX
MASTER_API_KEY=REPLACE_WITH_RANDOM_48_CHAR_HEX
GEMINI_API_KEY=REPLACE_WITH_GEMINI_KEY
# Encrypts tenant Meta/WhatsApp access tokens at rest.
# Generate the key with: openssl rand -base64 32
# During rotation, prepend the new key and keep old key entries until re-encryption is complete.
PROVIDER_TOKEN_ENCRYPTION_KEYS=primary:REPLACE_WITH_BASE64_32_BYTE_KEY

# Meta webhook credentials. Tenant phone IDs and access tokens are connected
# per business and stored encrypted in PostgreSQL; they are not global env variables.
META_VERIFY_TOKEN=REPLACE_WITH_YOUR_WEBHOOK_VERIFY_TOKEN
META_APP_SECRET=REPLACE_WITH_META_APP_SECRET
OWNER_PHONE=+94XXXXXXXXX
WHATSAPP_OTP_TEMPLATE=salespilot_otp

# Cloudinary media storage.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_RECEIPTS_URL=

# Resend transactional email.
RESEND_API_KEY=re_REPLACE_ME
RESEND_FROM_EMAIL=SalesPilot <noreply@salespilot.lk>

# PayHere. Only exact value false enables live checkout.
PAYHERE_MERCHANT_ID=REPLACE_ME
PAYHERE_MERCHANT_SECRET=REPLACE_ME
PAYHERE_SANDBOX=false

# Reserved app-level R2 settings. These are loaded but not consumed by the
# current app. Database backup storage is configured in /etc/salespilot/backup.env.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional Discord operational alerts.
DISCORD_GENERAL_ISSUES_WEBHOOK_URL=
DISCORD_CRITICAL_ISSUES_WEBHOOK_URL=

# Bootstrap and maintenance. Keep SEED_DB=false in production. Remove the
# initial password after the first super-admin login and password rotation.
SEED_DB=false
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_INITIAL_PASSWORD=
