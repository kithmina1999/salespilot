# .env.production.example
# Copy this to .env.production on the VPS and fill in real values.
# NEVER commit .env.production to git.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
GIN_MODE=release
SERVER_URL=https://api.salespilot.lk
FRONTEND_URL=https://app.salespilot.lk,https://admin.salespilot.lk

# ── Database (Supabase / Neon / self-hosted Postgres) ────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/salespilot?sslmode=require

# Shared pipeline state (required for multi-instance production)
# Use a managed Redis/Valkey instance. REDIS_URL may be redis:// or rediss://.
STATE_STORE=redis
REDIS_URL=rediss://:password@host:6379/0
REDIS_KEY_PREFIX=salespilot

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX

# ── Master API Key (system admin endpoints) ──────────────────────────────────
# Generate: openssl rand -hex 24
MASTER_API_KEY=REPLACE_WITH_RANDOM_48_CHAR_HEX

# ── AI Provider ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=REPLACE_WITH_GEMINI_KEY

# ── Meta / WhatsApp ──────────────────────────────────────────────────────────
META_VERIFY_TOKEN=REPLACE_WITH_YOUR_WEBHOOK_VERIFY_TOKEN
META_APP_SECRET=REPLACE_WITH_META_APP_SECRET
# Per-tenant tokens are stored in DB — these are fallback/owner defaults only
WA_PHONE_NUMBER_ID=REPLACE_IF_NEEDED
WA_ACCESS_TOKEN=REPLACE_IF_NEEDED
OWNER_PHONE=+94XXXXXXXXX

# ── Cloudinary (product images) ──────────────────────────────────────────────
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_REPLACE_ME
RESEND_FROM_EMAIL=SalesPilot <noreply@salespilot.lk>

# ── Payment Gateway (PayHere) ─────────────────────────────────────────────────
PAYHERE_MERCHANT_ID=REPLACE_ME
PAYHERE_MERCHANT_SECRET=REPLACE_ME
PAYHERE_SANDBOX=false

# ── Cloudflare R2 (backups) ───────────────────────────────────────────────────
R2_ACCOUNT_ID=REPLACE_ME
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_ACCESS_KEY=REPLACE_ME
R2_BUCKET_NAME=salespilot

# ── Discord Alerts ────────────────────────────────────────────────────────────
DISCORD_GENERAL_ISSUES_WEBHOOK_URL=https://discord.com/api/webhooks/...
DISCORD_CRITICAL_ISSUES_WEBHOOK_URL=https://discord.com/api/webhooks/...
