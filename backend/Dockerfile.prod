# syntax=docker/dockerfile:1.7

FROM golang:1.26-alpine AS builder

WORKDIR /src
RUN apk add --no-cache ca-certificates git

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/salespilot .

FROM alpine:3.22 AS runner

RUN apk add --no-cache ca-certificates tzdata wget \
    && addgroup -S salespilot \
    && adduser -S -G salespilot salespilot

WORKDIR /app
ENV GIN_MODE=release \
    PORT=8080 \
    WA_SESSIONS_DB_PATH=/app/data/whatsapp_sessions.db

COPY --from=builder /out/salespilot /usr/local/bin/salespilot

RUN mkdir -p /app/uploads/products /app/uploads/receipts /app/data \
    && chown -R salespilot:salespilot /app

USER salespilot
EXPOSE 8080

CMD ["salespilot"]
