# Root level ignores
.DS_Store
*.log
*.sqlite
*.db

# Environment files contain credentials. Commit templates only.
.env
.env.*
**/.env
**/.env.*
!.env.example
!.env.*.example
!**/.env.example
!**/.env.*.example

# Backend ignores
backend/*.exe
backend/out.*
backend/whatsapp_sessions.db
backend/uploads/
backend/tmp/

# Keep child gitignores working
frontend/node_modules/
frontend/.next/
landing/node_modules/
landing/.next/
salespilot-admin-main/node_modules/
salespilot-admin-main/.next/

.agent
