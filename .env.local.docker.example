# Optional local Docker overrides.
# Copy to .env.local.docker only when you need to change defaults:
#   cp .env.local.docker.example .env.local.docker
#
# The compose file has safe local defaults, so this file is mostly for ports,
# seeded accounts, or pointing local builds at a different URL.

APP_ENV=local
APP_RELEASE=local
LOG_FORMAT=text
LOG_LEVEL=debug
GIN_MODE=debug

BACKEND_PORT=18080
FRONTEND_PORT=13000
ADMIN_PORT=13001
LANDING_PORT=13002
POSTGRES_PORT=15432
REDIS_PORT=16379

SERVER_URL=http://localhost:18080
FRONTEND_URL=http://localhost:13000,http://localhost:13001,http://localhost:13002,http://127.0.0.1:13000,http://127.0.0.1:13001,http://127.0.0.1:13002
NEXT_PUBLIC_SITE_URL=http://localhost:13002
NEXT_PUBLIC_APP_URL=http://localhost:13000
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.test
NEXT_PUBLIC_SUPPORT_PHONE_NUMBER=+94770000000
NEXT_PUBLIC_COMPANY_NAME=SalesPilot
NEXT_PUBLIC_COMPANY_ADDRESS=Local

POSTGRES_DB=salespilot
POSTGRES_USER=salespilot
POSTGRES_PASSWORD=local-postgres-password
DATABASE_URL=postgresql://salespilot:local-postgres-password@postgres:5432/salespilot?sslmode=disable

REDIS_KEY_PREFIX=salespilot-local

JWT_SECRET=local-jwt-secret-0123456789abcdef0123456789abcdef
MASTER_API_KEY=local-master-api-key-0123456789abcdef0123456789abcdef
GEMINI_API_KEY=local-gemini-api-key
PROVIDER_TOKEN_ENCRYPTION_KEYS=local:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

META_VERIFY_TOKEN=local-meta-verify-token
META_APP_SECRET=local-meta-app-secret
OWNER_PHONE=+94770000000
WHATSAPP_OTP_TEMPLATE=salespilot_otp

CLOUDINARY_URL=cloudinary://local:local@local
CLOUDINARY_RECEIPTS_URL=

RESEND_API_KEY=re_local
RESEND_FROM_EMAIL=SalesPilot <noreply@example.test>
EMAIL_VERIFICATION_REQUIRED=false

PAYHERE_MERCHANT_ID=local
PAYHERE_MERCHANT_SECRET=local
PAYHERE_SANDBOX=true

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

DISCORD_GENERAL_ISSUES_WEBHOOK_URL=
DISCORD_CRITICAL_ISSUES_WEBHOOK_URL=

SEED_DB=false
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_INITIAL_PASSWORD=

SENTRY_ENABLED=false
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=local
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_AUTH_TOKEN=
SENTRY_ORG=salespilot-5b
SENTRY_FRONTEND_PROJECT=frontend-salespilot
SENTRY_FRONTEND_DSN=
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_FRONTEND_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
NEXT_PUBLIC_SENTRY_RELEASE=local
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
